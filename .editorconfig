# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Minecraft modding convention is 4 spaces for Java and Gradle.
[*.{java,gradle,kts}]
indent_size = 4
max_line_length = 120

[*.{json,json5,yml,yaml,toml,mcmeta}]
indent_size = 2

[*.md]
indent_size = 2
# Markdown uses two trailing spaces for a hard line break.
trim_trailing_whitespace = false

[*.{properties,cfg}]
indent_size = 4

[*.py]
indent_size = 4

[Makefile]
indent_style = tab

# Generated by Gradle — do not reformat.
[gradle/wrapper/**]
insert_final_newline = false
trim_trailing_whitespace = false

[gradlew.bat]
end_of_line = crlf
