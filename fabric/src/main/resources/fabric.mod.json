{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_sources}",
    "issues": "${mod_issues}"
  },
  "license": "${mod_license}",
  "icon": "assets/${mod_id}/icon.png",

  "environment": "client",

  "entrypoints": {
    "main": [
      "com.statusoverlay.mod.fabric.StatusOverlayFabric"
    ],
    "client": [
      "com.statusoverlay.mod.fabric.client.StatusOverlayFabricClient"
    ]
  },

  "mixins": [
    "${mod_id}.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  },

  "suggests": {}
}
